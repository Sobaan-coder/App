# ─────────────────────────────────────────────────────────────────────────────
# MY AI COMMAND CENTER — environment configuration
# Copy to .env and fill in. NEVER commit .env. Everything below except the
# "REQUIRED" block is optional: the app runs at $0 with no AI keys at all.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Local Postgres or Supabase (Project Settings → Database → Connection string, "Session pooler").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/command_center
# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
ENCRYPTION_KEY=

# ── APP ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Public HTTPS URL of this app. Needed only for Instagram publishing (Instagram fetches the image by URL).
PUBLIC_BASE_URL=
# First account can always sign up. Set true to allow more sign-ups.
ALLOW_SIGNUP=false
# Run the automation worker inside the Next.js server (good for local / VPS).
# Set false on Netlify/Vercel and run `npm run worker` elsewhere.
EMBEDDED_WORKER=true
STORAGE_DIR=./storage
DEFAULT_TIMEZONE=UTC
# Postgres TLS: set to "require" for Supabase / hosted Postgres.
DATABASE_SSL=

# ── AI (all optional; FREE options first) ───────────────────────────────────
# 1) Local & free: Ollama (https://ollama.com) e.g. `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# 2) Any OpenAI-compatible endpoint (free tiers: Groq, OpenRouter ":free" models, Gemini).
#    Groq:        https://api.groq.com/openai/v1              model: llama-3.1-8b-instant
#    OpenRouter:  https://openrouter.ai/api/v1                 model: meta-llama/llama-3.3-70b-instruct:free
#    Gemini:      https://generativelanguage.googleapis.com/v1beta/openai   model: gemini-2.5-flash
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Set true ONLY if this endpoint bills you. Paid providers are skipped unless enabled in Settings.
OPENAI_COMPAT_IS_PAID=false

# ── IMAGE GENERATION (optional) ─────────────────────────────────────────────
# Gemini API key from https://aistudio.google.com/apikey. To GUARANTEE $0, use a key
# from a Google Cloud project WITHOUT billing enabled: Google then cannot charge,
# requests simply fail with a quota error and the app falls back.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Local Stable Diffusion (AUTOMATIC1111 / Forge / SD.Next started with --api)
LOCAL_SD_URL=
# Pollinations.ai free public image API (no key). Sends your prompt to a third party.
POLLINATIONS_ENABLED=false

# ── VOICE (optional) ────────────────────────────────────────────────────────
# Voice works with NO setup in Chrome/Edge (browser speech recognition, Urdu + English).
# For Firefox/Safari or fully local transcription, point this at any OpenAI-compatible
# /audio/transcriptions endpoint running Whisper:
#   Local & free:  faster-whisper-server / Speaches  → http://localhost:8000/v1   model: Systran/faster-whisper-small
#   Free tier:     Groq → https://api.groq.com/openai/v1   model: whisper-large-v3 (supports Urdu)
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3
STT_IS_PAID=false

# ── WEB RESEARCH (optional; Wikipedia works with no key) ────────────────────
# Self-hosted SearXNG (free, private): https://docs.searxng.org
SEARXNG_URL=
# Brave Search API free plan (monthly quota, key required)
BRAVE_API_KEY=

# ── BROWSER AUTOMATION ──────────────────────────────────────────────────────
# Leave empty to use Playwright's bundled Chromium (`npx playwright install chromium`).
PLAYWRIGHT_CHROMIUM_PATH=

# ── NOTIFICATIONS (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── SOCIAL (official APIs only; all optional) ───────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── DANGER ZONE ─────────────────────────────────────────────────────────────
# shell_command tool is disabled unless true; even then every call needs explicit confirmation.
SHELL_COMMANDS_ENABLED=false

# ── REMOTE / PHONE ACCESS ───────────────────────────────────────────────────
# Extra addresses you open the app from (comma separated), e.g. your Tailscale or tunnel URL.
# APP_URL and PUBLIC_BASE_URL are always allowed.
ALLOWED_ORIGINS=
