# ─────────────────────────────────────────────────────────────────────────────
# BusinessPilot environment variables. Copy to .env (never commit real values).
# ─────────────────────────────────────────────────────────────────────────────

# ── PUBLIC (safe in the Flutter client; protected by Row Level Security) ─────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
APP_ENV=development            # development | staging | production
SITE_URL=https://businesspilot.app
GOOGLE_AUTH_ENABLED=false

# ── SERVER-SIDE ONLY (Supabase secrets — `supabase secrets set --env-file supabase/.env`)
# Never put these in the Flutter app or the website build.
AI_PROVIDER=openai             # openai | gemini | none
AI_API_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
AI_API_KEY=
AI_MODEL=gpt-4o-mini
ALLOWED_ORIGINS=https://businesspilot.app,http://localhost:3000
CRON_SECRET=generate-a-long-random-string
STRIPE_WEBHOOK_SECRET=
GOOGLE_PLAY_PUBSUB_TOKEN=
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected into
# Edge Functions automatically by Supabase. The service-role key must NEVER be
# used in the client.
