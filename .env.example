# =============================================================================
# Study OS — environment variables
# Copy to .env.local for development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser — only public values there.
# =============================================================================

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — used for background jobs, usage logs and the admin panel.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (used in auth email links and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" after enabling Google in Supabase → Authentication → Providers
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- AI provider (server only) -----------------------------------------------
# "anthropic" (default, Claude via the Anthropic SDK) or "openai" (any OpenAI-compatible API)
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional: base URL for OpenAI-compatible hosts (OpenRouter, Together, Groq, Azure, Ollama…)
AI_BASE_URL=
# Strong model: study plans, past-paper mapping, tutor. Defaults (anthropic): claude-opus-5-5
AI_MODEL=
# Cheap model: tagging, classification, command routing. Defaults (anthropic): claude-haiku-4-5
AI_FAST_MODEL=

# --- Embeddings (server only, OpenAI-compatible /embeddings) -----------------
# Leave EMBEDDING_MODEL empty to use full-text search only (still works, less semantic).
EMBEDDING_MODEL=text-embedding-3-small
# Defaults to AI_API_KEY when empty (useful when AI_PROVIDER=openai)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Must match the vector(1536) columns in the database
EMBEDDING_DIMENSIONS=1536

# --- Limits & jobs ------------------------------------------------------------
AI_RATE_LIMIT_PER_HOUR=60
MAX_UPLOAD_MB=25
# Protects /api/cron/process-jobs (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
